# fiken (read) — copy to a real file and point FIKEN_ENV at it, or export directly.
#   cp env.example ~/.config/fiken/.env  &&  export FIKEN_ENV=~/.config/fiken/.env
# Best: a personal API token from a Fiken user with the role
# "Se regnskapet uten å kunne gjøre endringer" (Rediger konto → API).
FIKEN_READ_TOKEN=your-read-only-fiken-token
FIKEN_COMPANY_SLUG=your-company-as
